/*
 * pwr-logger peripherals on the ProMicro nRF52840 (upstream board
 * `promicro_nrf52840/nrf52840`). Pins verified against the board DTS.
 *
 * Series load path (high-side), INA228 nearest the load so its VBUS = load V:
 *   Supply+ --[INA240 1mOhm]--[INA228 2mOhm]-- Load+ ... Load- -- GND
 *   (all grounds common: supply-, both breakouts, MCU, load return)
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>

/ {
	zephyr,user {
		/* INA228 CNVR/ALERT (open-drain, active-low) -> GPIOTE -> PPI ->
		 * TIMER.CAPTURE: hardware-timestamps each slow conversion. */
		cnvr-gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

/* P0.13 enables the board's external 3.3V rail (nice!nano-style power gate) --
 * pulling it low cuts 3.3V to the INA228/INA240/SD. Hog it HIGH at boot and hold
 * it there, so the rail stays on regardless of application code. */
&gpio0 {
	vcc3v3_enable_hog {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

/* Free P1.04 / P1.06 (the I2C1 default pins) for use as SD-CS and CNVR. */
&i2c1 {
	status = "disabled";
};

/* INA228 precision channel — I2C Fast-mode-plus, address 0x40 (A0/A1 = GND).
 * Driven manually in ina228.c via the i2c0 bus device (no DT binding needed).
 * Add ~2.2k SDA/SCL pull-ups to 3V3 unless the breakout already has them. */
&i2c0 {
	compatible = "nordic,nrf-twim";	/* TWIM (EasyDMA) */
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;	/* 400 kHz — nRF52840 I2C max */
};

/* Level shifter/buffer removed -> the MCU drives the SD lines directly.
 * group1 = outputs (SCK/MOSI) at H0H1 high drive (max for nRF52840); the
 * default S0S1 gives weak edges into the card's pin load. group2 = MISO, the
 * card->MCU input, with the nRF internal pull-up (~13k) enabled so the line
 * isn't left floating between the card's drive phases. (No pull-up on SCK: it
 * would fight the CPOL=0 idle-low.) */
&spi2_default {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 1, 1)>,
			<NRF_PSEL(SPIM_MOSI, 1, 2)>;
		nordic,drive-mode = <NRF_DRIVE_H0H1>;
	};
	group2 {
		psels = <NRF_PSEL(SPIM_MISO, 1, 7)>;
		bias-pull-up;
	};
};

/* SD card on SPIM2 (board default pins: SCK P1.01, MOSI P1.02, MISO P1.07).
 * ~8 MHz ~= 1 MB/s, 2.5x the 400 kB/s need. CS = P1.04 (freed from I2C1).
 * For more headroom (multichannel) later, move SD to SPIM3 @ 32 MHz. */
&spi2 {
	/* The board defaults spi2 to the legacy byte-IRQ "nordic,nrf-spi" driver,
	 * which fires one interrupt per byte -> at ~390 kB/s of TDMS writes the SPI
	 * ISR starves every other thread. Use SPIM (EasyDMA): one DMA transfer per
	 * buffer. SPIM2 is free (I2C uses TWIM0); 8 MHz max, 64 kB max-count. */
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio1 4 (GPIO_ACTIVE_LOW | NRF_GPIO_DRIVE_H0H1 | GPIO_PULL_UP)>;

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <8000000>;
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/*
 * SAADC fast channel: INA240 OUT -> RC anti-alias (62 ohm + 33 nF, ~78 kHz) ->
 * P0.31 = AIN7. Configured in acquisition.c via nrfx (no DT node needed; do NOT
 * also enable the Zephyr `adc` driver, or both would claim the SAADC).
 */
